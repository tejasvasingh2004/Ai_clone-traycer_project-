{
  "name": "traycer-mini",
  "version": "1.0.0",
  "description": "A simplified AI-powered code generation workflow tool demonstrating planning, generation, review, and verification",
  "main": "dist/cli.js",
  "bin": {
    "traycer-mini": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/api.ts",
    "dashboard": "cd traycer-mini-frontend && npm run dev",
    "dev:full": "concurrently \"npm run server\" \"npm run dashboard\""
  },
  "keywords": [
    "ai",
    "code-generation",
    "cli",
    "typescript",
    "openai",
    "anthropic",
    "workflow"
  ],
  "author": "Traycer-mini Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "diff": "^5.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.0",
    "openai": "^4.0.0",
    "ora": "^8.0.0",
    "pg": "^8.22.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/diff": "^5.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prisma": "^7.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
