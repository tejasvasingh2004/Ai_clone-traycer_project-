# Traycer-mini Environment Configuration
# Copy this file to .env and add your actual API keys

# Choose one AI provider:
# For OpenAI (GPT-4):
# OPENAI_API_KEY=your_openai_api_key_here
# OR for Anthropic (Claude):
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OR for Google Gemini:
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OR for Groq (fast inference, OpenAI-compatible):
# GROQ_API_KEY=your_groq_api_key_here

# Optional: specify model (defaults shown below)
# For OpenAI, default is gpt-4o-mini
# For Anthropic, default is claude-3-5-sonnet-20241022
# For Google, default is gemini-pro
# For Groq, default is llama-3.3-70b-versatile
# AI_MODEL=llama-3.3-70b-versatile

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Uncomment and add your API key for your chosen provider
# 3. (Optional) Uncomment and set AI_MODEL if you want to use a different model
# 4. Never commit the .env file to version control

NEON_DB_API=
GROQ_API_KEY=
AI_MODEL=